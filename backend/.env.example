# RTSP URL for the CCTV camera. Use "0" to fall back to a local webcam for testing.
RTSP_URL=rtsp://username:password@camera-ip:554/stream1

# Frame width the backend downscales to before processing. Lower = faster/cheaper.
PROCESS_WIDTH=640

# Run detection every Nth frame; skipped frames reuse the last detection.
DETECT_EVERY_N_FRAMES=2

# Output stream frame rate to the frontend (also caps CPU spent encoding JPEGs).
OUTPUT_FPS=15

# JPEG quality for streamed frames (0-100). Lower = less bandwidth.
JPEG_QUALITY=70

# Virtual counting line, as fractions (0..1) of the processed frame.
LINE_X1=0.05
LINE_Y1=0.55
LINE_X2=0.95
LINE_Y2=0.55

# Comma-separated allowed origins for the frontend dev/prod URL.
CORS_ORIGINS=http://localhost:5173
