# RTSP URL for the CCTV camera. Use "0" to fall back to a local webcam for testing.
RTSP_URL=rtsp://username:password@camera-ip:554/stream1

# Frame width the backend downscales to before processing. Lower = faster/cheaper.
# On a Raspberry Pi, 480 is a safer starting point than 640.
PROCESS_WIDTH=640

# Run detection every Nth frame; skipped frames reuse the last detection.
# On a Raspberry Pi with the YOLO backend, 3 is a safer starting point.
DETECT_EVERY_N_FRAMES=2

# Output stream frame rate to the frontend (also caps CPU spent encoding JPEGs).
OUTPUT_FPS=15

# JPEG quality for streamed frames (0-100). Lower = less bandwidth.
JPEG_QUALITY=70

# "yolo" = labeled boxes (car/truck/bus/motorcycle) via YOLOv8n ONNX + cv2.dnn.
# "bgsub" = older no-label background-subtraction fallback (no .onnx needed).
DETECTOR_BACKEND=yolo
YOLO_ONNX_PATH=models/yolov8n.onnx
# Model input size in pixels (square). 320 is the Pi-friendly default;
# must match the imgsz used in scripts/export_yolo_onnx.py.
YOLO_INPUT_SIZE=320
YOLO_CONF_THRESHOLD=0.35
YOLO_NMS_THRESHOLD=0.45

# Virtual counting line, as fractions (0..1) of the processed frame.
# Default below is a VERTICAL line for a SIDEVIEW camera (vehicles move
# left<->right across the frame). For a top-down/angled camera instead,
# use a horizontal line, e.g. 0.05,0.55 -> 0.95,0.55.
LINE_X1=0.5
LINE_Y1=0.05
LINE_X2=0.5
LINE_Y2=0.95

# Comma-separated allowed origins for the frontend dev/prod URL.
CORS_ORIGINS=http://localhost:5173
