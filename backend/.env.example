# RTSP URL for the CCTV camera. For testing without a real camera:
#   - a local video file path (looped automatically) plays as a stand-in
#     "live" feed — see backend/demo_videos/ after running the download
#   - "0" uses your laptop webcam instead
RTSP_URL=demo_videos/sideview.mp4

# Frame width the backend downscales to before processing. Lower = faster/cheaper.
PROCESS_WIDTH=640

# Run detection every Nth frame; skipped frames reuse the last detection.
DETECT_EVERY_N_FRAMES=2

# Output stream frame rate to the frontend (also caps CPU spent encoding JPEGs).
OUTPUT_FPS=15

# JPEG quality for streamed frames (0-100). Lower = less bandwidth.
JPEG_QUALITY=70

# "yolo" labels vehicle type (Car/Truck/Bus/Motorbike) using a YOLOv8n ONNX
# model via cv2.dnn — see backend/scripts/export_yolo_onnx.py to produce it.
# Falls back to "bg_subtraction" automatically if the model file is missing
# (cheaper, but everything is labeled generically "Vehicle").
DETECTOR_BACKEND=yolo
YOLO_MODEL_PATH=models/yolov8n.onnx
YOLO_INPUT_SIZE=320
YOLO_CONF_THRESHOLD=0.4
YOLO_NMS_THRESHOLD=0.45

# Virtual counting line ("tripwire"), as fractions (0..1) of the processed
# frame. Default is a VERTICAL line at mid-width, for a sideview camera
# where vehicles travel left<->right across frame. For a top-down/overhead
# camera, use a horizontal line instead (e.g. Y1=Y2=0.55, X1=0.05, X2=0.95).
LINE_X1=0.5
LINE_Y1=0.1
LINE_X2=0.5
LINE_Y2=0.9

# How many recent crossing events the /events endpoint keeps in memory.
EVENT_LOG_SIZE=200

# Comma-separated allowed origins for the frontend dev/prod URL.
CORS_ORIGINS=http://localhost:5173
